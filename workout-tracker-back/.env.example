# Server Configuration
PORT=8080
GIN_MODE=debug  # debug, release, test

# Supabase Database
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_PROJECT].pooler.supabase.com:6543/postgres

# JWT Configuration (for WhatsApp magic links)
# Must be at least 32 characters. Use the same secret in n8n environment.
JWT_SECRET=your-super-secret-key-min-32-chars-here
