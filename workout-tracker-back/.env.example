# Server Configuration
PORT=8080
GIN_MODE=debug  # debug, release, test

# CORS Configuration
# Comma-separated list of allowed origins. Use "*" to allow all (not recommended for production)
# Examples:
#   Local development: http://localhost:5173
#   Production: https://[FIREBASE_PROJECT_ID].web.app
#   Multiple origins: http://localhost:5173,https://[FIREBASE_PROJECT_ID].web.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase Database
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres
