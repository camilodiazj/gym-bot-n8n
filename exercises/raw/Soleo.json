        "muscles": [
            {
                "id": 11,
                "name": "Gemelos",
                "name_en_us": "Calves",
                "scientific_name": null,
                "url_name": "Calves",
                "description": "Los gemelos están formados por dos músculos: el gastrocnemio y el sóleo. Ambos músculos se activan cada vez que se flexiona la articulación del tobillo. Es decir, los gemelos participan cada vez que das un paso, te pones de pie o saltas.",
                "description_en_us": "The calves are composed of two muscles, the gastrocnemius, and the soleus. Both muscles are active every time the ankle joint flexes. In other words, the calves are involved every time you take a step, stand up, or jump.",
