    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select users.full_phone_number, users.full_name, day_name as session_name, uws.week, json_agg(json_build_object('spanish_name', spanish_name, 'main_muscle', main_muscle, 'reps', reps, 'sets', sets, 'rir', rir, 'link', link, 'rest_seconds', \"rest-seconds\")) as exercises from user_weekly_schedule uws join users using(user_id) join workouts on (users.user_id = workouts.user_id and uws.week = workouts.week and uws.session_name = workouts.day_name) join exercises using(exercise_id) where uws.day_routine_id = '{{ $json.day_routine_id }}' group by users.full_phone_number, users.full_name, day_name, uws.week",
