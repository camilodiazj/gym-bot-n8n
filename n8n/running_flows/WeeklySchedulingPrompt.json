    {
      "parameters": {
        "jsCode": "// Tag each user with their scenario and test mode flag\nconst data = $input.first().json;\nconst isTest = $('check_test_mode').first().json.is_test;\nlet scenario = 'GROWTH';\n\nif (data.completed_count === data.total_sessions) {\n  scenario = 'CELEBRATION';\n} else if (data.completed_count === 0) {\n  scenario = 'RE_ENGAGEMENT';\n}\n\nconsole.log(`📊 ${data.full_name} → ${scenario} (${data.completed_count}/${data.total_sessions})${isTest ? ' [TEST]' : ''}`);\n\nreturn [{ json: { ...data, scenario, is_test: isTest } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
