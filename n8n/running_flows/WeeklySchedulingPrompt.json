      "id": "a1b2c3d4-test-4000-8000-000000000099",
      "name": "execute_workflow_trigger"
    },
    {
      "parameters": {
        "jsCode": "// When called via Execute Workflow (test runner), input has test_phone_filter.\n// When triggered by cron, input is empty => phone_filter defaults to '%' (all users).\nconst triggerData = $input.first()?.json || {};\nconst phoneFilter = triggerData.test_phone_filter || '%';\nconst isTest = phoneFilter !== '%';\n\nif (isTest) {\n  console.log(`🧪 TEST MODE: phone_filter = ${phoneFilter}`);\n} else {\n  console.log('🚀 PRODUCTION MODE: no phone filter');\n}\n\nreturn [{ json: { phone_filter: phoneFilter, is_test: isTest } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2208,
        384
      ],
      "id": "a1b2c3d4-test-4000-8000-000000000010",
      "name": "check_test_mode"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH current_week_stats AS (\n    SELECT\n        u.user_id,\n        u.full_phone_number,\n        u.full_name,\n        uws.week::int AS current_week,\n        ws.days_per_week::int AS total_sessions,\n        COUNT(*) FILTER (WHERE uws.\"Completed\" = true)::int AS completed_count,\n        MAX(\n            CASE\n                WHEN uws.planned_day ~ '^\\d{4}-' THEN uws.planned_day::date\n                ELSE TO_DATE(uws.planned_day, 'DD/MM/YYYY')\n            END\n        ) AS last_planned_date\n    FROM users u\n    JOIN users_plans up ON u.user_id = up.user_id AND up.status = 'active'\n    JOIN week_schedules ws ON up.week_schedule = ws.schedule_type\n    JOIN user_weekly_schedule uws ON u.user_id = uws.user_id\n    WHERE uws.week BETWEEN 1 AND 3\n      AND u.full_phone_number::text LIKE '{{ $json.phone_filter }}'\n    GROUP BY u.user_id, u.full_phone_number, u.full_name, uws.week, ws.days_per_week\n)\nSELECT DISTINCT ON (user_id)\n    user_id, full_phone_number, full_name, current_week,\n    total_sessions, completed_count, last_planned_date\nFROM current_week_stats cws\nWHERE cws.last_planned_date < (NOW() AT TIME ZONE 'America/Bogota')::date\n  AND cws.last_planned_date >= ((NOW() AT TIME ZONE 'America/Bogota') - INTERVAL '3 days')::date\n  AND NOT EXISTS (\n      SELECT 1 FROM user_weekly_schedule uws2\n      WHERE uws2.user_id = cws.user_id\n        AND uws2.week = cws.current_week + 1\n  )\nORDER BY user_id, current_week DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -1968,
        384
      ],
      "id": "a223ee98-b2b0-49bb-9cf6-43c13afc58fd",
