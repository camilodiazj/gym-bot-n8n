      "parameters": {
        "jsCode": "// Accedemos a los datos usando los métodos correctos de n8n para JavaScript\nconst fullName = $('Execute Workflow Trigger').first().json.full_name;\nconst mesocycleNumber = $('Increment_Mesocycle').first().json.mesocycle_number;\n\nconst msg = `¡Perfecto ${fullName}! 🎉\n\nTu mesociclo ${mesocycleNumber} ha iniciado con la misma rutina. Ahora puedes agendar tu Semana 1.\n\n¡Escríbeme cuando quieras agendar! 💪`;\n\nreturn [\n  {\n    json: {\n      output: msg\n    }\n  }\n];"
