    {
      "parameters": {
        "jsCode": "// Extraer número de días del mensaje del usuario\nconst userMessage = $items('Execute Workflow Trigger')[0].json.user_message.toLowerCase();\n\n// Buscar número entre 2 y 6\nlet newDays = null;\nconst match = userMessage.match(/(\\d+)\\s*d[ií]as?/);\nif (match) {\n  const days = parseInt(match[1]);\n  if (days >= 2 && days <= 6) {\n    newDays = days;\n  }\n}\n\n// Si no encontró, buscar palabras\nif (!newDays) {\n  if (userMessage.includes('dos') || userMessage.includes('2')) newDays = 2;\n  else if (userMessage.includes('tres') || userMessage.includes('3')) newDays = 3;\n  else if (userMessage.includes('cuatro') || userMessage.includes('4')) newDays = 4;\n  else if (userMessage.includes('cinco') || userMessage.includes('5')) newDays = 5;\n  else if (userMessage.includes('seis') || userMessage.includes('6')) newDays = 6;\n}\n\nreturn [{\n  json: {\n    new_days: newDays,\n    user_id: $items('Execute Workflow Trigger')[0].json.user_id,\n    whatsapp_id: $items('Execute Workflow Trigger')[0].json.whatsapp_id\n  }\n}];"
      },
