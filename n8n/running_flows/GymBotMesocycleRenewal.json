    {
      "parameters": {
        "jsCode": "// Seleccionar ejercicio alternativo aleatorio diferente al actual\nconst alternatives = $input.all();\nconst currentExerciseId = $items('Loop_Rotate_Exercises')[0].json.exercise_id;\n\n// Filtrar alternativas diferentes\nconst filtered = alternatives.filter(ex => ex.json.exercise_id !== currentExerciseId);\n\nif (filtered.length === 0) {\n  // No hay alternativas, mantener el mismo\n  return [{\n    json: {\n      workout_id: $items('Loop_Rotate_Exercises')[0].json.id,\n      new_exercise_id: currentExerciseId\n    }\n  }];\n}\n\n// Seleccionar uno aleatorio\nconst randomIndex = Math.floor(Math.random() * filtered.length);\nconst selectedExercise = filtered[randomIndex].json.exercise_id;\n\nreturn [{\n  json: {\n    workout_id: $items('Loop_Rotate_Exercises')[0].json.id,\n    new_exercise_id: selectedExercise\n  }\n}];"
      },
