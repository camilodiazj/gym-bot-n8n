      "credentials": {
        "postgres": {
          "id": "vZLJtIWG5nYXMez4",
          "name": "Supabase Memory"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
