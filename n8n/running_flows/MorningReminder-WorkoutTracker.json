        "query": "INSERT INTO n8n_workflow_errors (workflow_name, error_message, error_timestamp, context)\nVALUES (\n  'MorningReminder-WorkoutTracker',\n  $1,\n  NOW() AT TIME ZONE 'America/Bogota',\n  $2\n)",
