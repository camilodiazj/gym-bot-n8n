    {
      "parameters": {
        "instructions": "Unify all the items in a single Json strucutured array,",
        "codeGeneratedForPrompt": "Unify all the items in a single Json strucutured array,",
        "jsCode": "const items = $input.all();\nconst unifiedArray = items.map((item) => item.json);\nreturn [{ json: { unifiedArray }, pairedItem: items.map((_, index) => index) }];\n"
      },
      "type": "n8n-nodes-base.aiTransform",
      "typeVersion": 1,
      "position": [
        1248,
        3616
      ],
      "id": "81c802f9-f932-4abe-9f8b-5ee9292e110d",
      "name": "AI Transform"
    },
    {
      "parameters": {
        "jsCode": "// Arreglo para acumular todos los ejercicios finales\nlet allExercises = [];\n\n// Recorremos los ítems de entrada (usualmente es 1 que contiene el unifiedArray)\nfor (const item of $input.all()) {\n  const unified = item.json.unifiedArray;\n\n  if (Array.isArray(unified)) {\n    for (const entry of unified) {\n      try {\n        // Parseamos el string de 'output' para convertirlo en lista de objetos\n        const exercises = JSON.parse(entry.output);\n        \n        // Agregamos los ejercicios al arreglo maestro\n        allExercises.push(...exercises);\n      } catch (error) {\n        // Ignoramos errores de parseo si algún output viene mal\n        continue;\n      }\n    }\n  }\n}\n\n// Retornamos cada ejercicio como un ítem independiente para n8n\nreturn allExercises.map(exercise => ({ json: exercise }));"
      },
