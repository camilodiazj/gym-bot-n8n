        "query": "select day_req.*, rt.template_id ,rt.goal, rt.level, rt.week_schedule\nfrom routine_templates rt\njoin template_days using(week_schedule)\njoin day_requirements as day_req using (template_day_id)  \nwhere days_per_week = {{ $items('GetUserProfile')[0].json.days_available }}\nand goal = '{{ $items('GetUserProfile')[0].json.primary_goal }}'\nand level = '{{ $items('GetUserProfile')[0].json.fitness_level }}';",
