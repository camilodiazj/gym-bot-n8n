# API Configuration
# For local development, use: http://localhost:8080/api/v1
# For production, use: https://workout-api-[GCP_PROJECT_NUMBER].us-central1.run.app/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Development User ID (only used when no ?c= code in URL)
# Set this to a valid user_id from your local database for testing
VITE_DEV_USER_ID=YOUR_DEV_USER_UUID
